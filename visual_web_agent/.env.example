# VSpider environment example
# Copy this file to .env and fill in the values you actually use.

# ========== VLM ==========
VLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=sk-your-api-key-here
VLM_MODEL_NAME=qwen3-vl-plus

# ========== Browser persistence ==========
# Reuse cookies and local storage between runs.
# BROWSER_USER_DATA_DIR=./browser_data

# ========== Page waiting ==========
PAGE_STABLE_TIMEOUT=15000
PAGE_FALLBACK_WAIT=3.0

# ========== Vocabulary extensions for intranet / grid systems ==========
# Comma-separated plain keywords. These extend the built-in defaults and do not
# replace them. Use them when your internal systems have domain-specific terms.
#
# Login-related words that should make VSpider treat the goal/page as an auth flow.
# Example: UAP, 统一门户, 安全接入平台, 数字证书
# VSPIDER_EXTRA_LOGIN_KEYWORDS=统一门户,安全接入平台,数字证书,令牌,口令
#
# URL fragments that usually indicate a login / auth page in your environment.
# Example: uap, sso, authserver, portal, unifylogin
# VSPIDER_EXTRA_LOGIN_URL_KEYWORDS=uap,portal,unifylogin
#
# Business words that suggest the task depends on visually finding rows/cards/items.
# Example: 保护定值单, 操作票, 工作票, 设备台账, 隐患清单
# VSPIDER_EXTRA_VISUAL_NAV_KEYWORDS=操作票,工作票,设备台账,隐患清单,保护定值单

# Extra global navigation labels that should be ignored for list/item tasks.
# Example: home, movie, dashboard, console
# VSPIDER_EXTRA_GLOBAL_NAV_KEYWORDS=
#
# true  = list/ranking/table/result tasks prefer vision mode by default.
# false = still allow text-only first, then rely on sparse-DOM fallback.
VSPIDER_FORCE_VISION_FOR_LIST_TASKS=true

# ========== Message Compaction（历史压缩）==========
# 长任务时自动用 LLM 摘要压缩旧操作历史，避免 token 溢出。
# true = 启用压缩（推荐），false = 仅硬截断
VSPIDER_COMPACTION_ENABLED=true
# 历史条目数超过此值时触发压缩
VSPIDER_COMPACTION_TRIGGER_COUNT=12
# 历史文本字符总数超过此值时也触发压缩
VSPIDER_COMPACTION_TRIGGER_CHARS=8000
# 压缩后保留最近的原始记录数（不被摘要覆盖）
VSPIDER_COMPACTION_KEEP_LAST=6
# 两次压缩之间的最小步数冷却
VSPIDER_COMPACTION_COOLDOWN=5

# ========== Judge（任务完成验证）==========
# Agent 输出 done 后用独立 LLM 调用验证任务是否真正完成，减少假完成。
VSPIDER_JUDGE_ENABLED=true

# ========== A11y Enhancer（无障碍树增强）==========
# 增强 AX Tree 输出：元素状态标注、隐藏元素提示等。
VSPIDER_A11Y_ENHANCER_ENABLED=true

# ========== Response Cache / Replay 模式 ==========
# off    = 禁用（默认；走真实 VLM 调用）
# record = 真实调用并把每步的 (输入哈希, 输出) 写入 JSONL 文件
# replay = 跳过真实 VLM 调用，按步骤号从缓存返回（用于 prompt 调优 / 回归测试）
VSPIDER_CACHE_MODE=off
# 缓存目录（相对/绝对路径均可）
VSPIDER_CACHE_DIR=.cache/vlm_responses
# Session ID（留空自动生成时间戳）。Replay 时必填以指定要回放的会话。
VSPIDER_CACHE_SESSION_ID=
# Replay 模式下输入哈希不一致时是否抛错（默认仅警告）
VSPIDER_CACHE_REPLAY_STRICT=false
# Replay 模式找不到记录时是否回落到真实调用（默认抛错）
VSPIDER_CACHE_REPLAY_FALLBACK=false

# ========== Element Tracker（自适应元素重定位）==========
# 启用后可通过 vlm.track_element() / vlm.relocate_element() 在 DOM 重排后
# 按结构签名（tag/text/role/aria/class/bbox/parent_chain）找回元素。
# 开关关闭时所有方法降级为 no-op，无任何额外开销。
VSPIDER_ELEMENT_TRACKER_ENABLED=true
# 匹配阈值：候选总分 ≥ 此值视为成功
VSPIDER_ELEMENT_TRACKER_MATCH_THRESHOLD=0.55
# 高置信度门槛：超过此值的匹配被视为强匹配，可以无条件复用
VSPIDER_ELEMENT_TRACKER_HIGH_CONFIDENCE=0.80

# ========== Safe auto login ==========
# Master switch for the native Playwright login interceptor.
VSPIDER_LOGIN_ENABLED=true

# false = only auto-login when a visible login form / login popup already exists.
# true  = proactively open the login flow when the page shows a login entry/login page signal.
VSPIDER_LOGIN_FORCE=false

# If you configure one or more site profiles below, unmatched hosts will skip
# auto-login by default so VSpider does not try the wrong account on the wrong site.
# Uncomment this only if you intentionally want unmatched hosts to fall back to
# the global credentials defined below.
# VSPIDER_LOGIN_ALLOW_GLOBAL_FALLBACK=true

# ========== Global default credentials ==========
# These are used when no site profiles are configured.
VSPIDER_LOGIN_USER=your_phone_number
VSPIDER_LOGIN_PWD=your_password

# Global selector overrides. These are safe defaults you can keep or replace.
# For real sites such as Baidu, Bilibili, or internal admin panels, use precise selectors.
# VSPIDER_LOGIN_OPEN_SELECTOR=a:has-text("登录"), button:has-text("登录")
# VSPIDER_LOGIN_PASSWORD_MODE_SELECTOR=text=/密码登录|账号登录/i
# VSPIDER_LOGIN_USER_SELECTOR=input[name='userName']
# VSPIDER_LOGIN_PWD_SELECTOR=input[type='password']
# VSPIDER_LOGIN_SUBMIT_SELECTOR=button[type='submit']
# VSPIDER_LOGIN_SUCCESS_SELECTOR=.user-avatar
VSPIDER_LOGIN_SUCCESS_TIMEOUT_MS=10000

# ========== Multi-site credential profiles ==========
# Format:
# VSPIDER_LOGIN_SITE_<SITE_KEY>_DOMAINS=example.com,login.example.com
# VSPIDER_LOGIN_SITE_<SITE_KEY>_USER=account_for_that_site
# VSPIDER_LOGIN_SITE_<SITE_KEY>_PWD=password_for_that_site
#
# Optional per-site selector overrides:
# VSPIDER_LOGIN_SITE_<SITE_KEY>_OPEN_SELECTOR=...
# VSPIDER_LOGIN_SITE_<SITE_KEY>_PASSWORD_MODE_SELECTOR=...
# VSPIDER_LOGIN_SITE_<SITE_KEY>_USER_SELECTOR=...
# VSPIDER_LOGIN_SITE_<SITE_KEY>_PWD_SELECTOR=...
# VSPIDER_LOGIN_SITE_<SITE_KEY>_SUBMIT_SELECTOR=...
# VSPIDER_LOGIN_SITE_<SITE_KEY>_SUCCESS_SELECTOR=...
# VSPIDER_LOGIN_SITE_<SITE_KEY>_SUCCESS_TIMEOUT_MS=10000
#
# Matching rule:
# - VSpider compares the current page host against *_DOMAINS.
# - A profile matches when host == domain or host ends with ".<domain>".
# - The most specific matching domain wins.
#
# Example: Bilibili
# VSPIDER_LOGIN_SITE_BILIBILI_DOMAINS=bilibili.com,passport.bilibili.com
# VSPIDER_LOGIN_SITE_BILIBILI_USER=your_bilibili_account
# VSPIDER_LOGIN_SITE_BILIBILI_PWD=your_bilibili_password
# VSPIDER_LOGIN_SITE_BILIBILI_OPEN_SELECTOR=a:has-text("登录"), button:has-text("登录"), [role="button"]:has-text("登录")
# VSPIDER_LOGIN_SITE_BILIBILI_PASSWORD_MODE_SELECTOR=text=/密码登录|账号登录/i
# VSPIDER_LOGIN_SITE_BILIBILI_USER_SELECTOR=input[placeholder*="手机号" i], input[placeholder*="邮箱" i], input[placeholder*="账号" i], input[name*="user" i], input[autocomplete="username"]
# VSPIDER_LOGIN_SITE_BILIBILI_PWD_SELECTOR=input[type="password"], input[autocomplete="current-password"]
# VSPIDER_LOGIN_SITE_BILIBILI_SUBMIT_SELECTOR=button:has-text("登录"), [role="button"]:has-text("登录"), button[type="submit"]
# VSPIDER_LOGIN_SITE_BILIBILI_SUCCESS_SELECTOR=img[class*="avatar"], .header-avatar-wrap img, .bili-avatar-img
# VSPIDER_LOGIN_SITE_BILIBILI_SUCCESS_TIMEOUT_MS=12000
#
# Example: Baidu
# VSPIDER_LOGIN_SITE_BAIDU_DOMAINS=baidu.com,passport.baidu.com
# VSPIDER_LOGIN_SITE_BAIDU_USER=13800138000
# VSPIDER_LOGIN_SITE_BAIDU_PWD=your-baidu-password
# VSPIDER_LOGIN_SITE_BAIDU_OPEN_SELECTOR=a:has-text("登录")
# VSPIDER_LOGIN_SITE_BAIDU_PASSWORD_MODE_SELECTOR=text=/密码登录/i
# VSPIDER_LOGIN_SITE_BAIDU_USER_SELECTOR=input[name='userName']
# VSPIDER_LOGIN_SITE_BAIDU_PWD_SELECTOR=input[type='password']
# VSPIDER_LOGIN_SITE_BAIDU_SUBMIT_SELECTOR=button:has-text("登录")
# VSPIDER_LOGIN_SITE_BAIDU_SUCCESS_SELECTOR=.s-top-img-wrapper
#
# Example: Internal admin
# VSPIDER_LOGIN_SITE_ADMIN_PORTAL_DOMAINS=admin.example.com,sso.example.com
# VSPIDER_LOGIN_SITE_ADMIN_PORTAL_USER=your_admin_account
# VSPIDER_LOGIN_SITE_ADMIN_PORTAL_PWD=your_admin_password
# VSPIDER_LOGIN_SITE_ADMIN_PORTAL_OPEN_SELECTOR=button:has-text("Sign in")
# VSPIDER_LOGIN_SITE_ADMIN_PORTAL_USER_SELECTOR=input[name='email']
# VSPIDER_LOGIN_SITE_ADMIN_PORTAL_PWD_SELECTOR=input[name='password']
# VSPIDER_LOGIN_SITE_ADMIN_PORTAL_SUBMIT_SELECTOR=button[type='submit']
